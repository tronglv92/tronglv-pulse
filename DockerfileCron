FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o pulse-cron ./cmd/cron/main.go

FROM alpine:latest
RUN apk --no-cache add ca-certificates tzdata
WORKDIR /app
COPY --from=builder /app/pulse-cron .
COPY --from=builder /app/etc/cron.yaml ./etc/cron.yaml
CMD ["./pulse-cron", "-f", "etc/cron.yaml"]
