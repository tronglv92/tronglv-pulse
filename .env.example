# Pulse — Environment Variables
# Copy to .env before running locally: cp .env.example .env

# ── Runtime ──────────────────────────────────────────────────────────────────
SERVER_ENV=development

# ── API server ports ──────────────────────────────────────────────────────────
SERVICE_API_HTTP_PORT=8000
SERVICE_API_GRPC_PORT=8001
SERVICE_INGEST_HTTP_PORT=8002

# ── PostgreSQL (TimescaleDB + pgvector) ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=pulse_db
DB_USER=postgres
DB_PASSWORD=postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-before-production
INGEST_HMAC_SECRET=change-me-before-production

# ── LLM (Anthropic / OpenAI) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=

# ── LLM budget guard ──────────────────────────────────────────────────────────
LLM_DAILY_BUDGET_USD=5.0

# ── Notifications ─────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Telemetry (OpenTelemetry) ─────────────────────────────────────────────────
TELEMETRY_ENDPOINT=http://localhost:4318
